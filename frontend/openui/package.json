{
  "name": "ai365-openui-island",
  "private": true,
  "version": "0.1.0",
  "description": "Ai365 데모 채팅 답변용 OpenUI 섬 번들 / OpenUI island bundle for Ai365 demo chat answers",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build",
    "gen:prompt": "node scripts/gen-prompt.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "lucide-react": "0.562.0",
    "mermaid": "11.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@openuidev/cli": "0.6.0",
    "@openuidev/lang-core": "1.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
